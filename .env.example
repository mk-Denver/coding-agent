# LLM
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openrouter/glm-5.2

# GitHub (fine-grained PAT with repo + pull-requests + issues)
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=choose-a-random-secret

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# Agent
MAX_ITERATIONS=40

# Optional: model used to route natural-language Telegram messages
# (defaults to OPENROUTER_MODEL if unset; pick a cheap fast model)
# INTENT_MODEL=openrouter/glm-5.2
